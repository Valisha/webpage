---
import yaml from 'js-yaml';

export interface ChatTurn {
  q: string;
  a: string;
}

export interface ChatParticipant {
  name: string;
  photo: string;
}

interface Props {
  /** Optional terminal command typed and erased before the title animates in, e.g. "./social_analysis.sh khushbu". Omit to type the title directly. */
  terminalCommand?: string;
  /** Title that types in (after the terminal command is erased, if one is given) */
  terminalTitle: string;
  /** Sends messages on the right in the blue bubble */
  asker: ChatParticipant;
  /** Replies on the left in the gray bubble */
  responder: ChatParticipant;
  /** Raw YAML text (import a sibling `.yaml?raw` file) — an array of `{ q, a }` turns */
  conversationYaml: string;
}

const { terminalCommand = '', terminalTitle, asker, responder, conversationYaml } = Astro.props;

const conversation = yaml.load(conversationYaml) as ChatTurn[];

// Elements are created dynamically in the client script below, so ids must be
// unique per instance even though styles are `is:global` (see AGENTS.md's
// survey-results.astro precedent for why the styles have to be global).
const instanceId = `ichat-${Math.random().toString(36).slice(2, 9)}`;
---

{
  /* Purely decorative: the typing animation and chat bubbles are inserted by
    the client script below with no aria-live region, so a screen reader has
    no way to follow them. The real content is the static transcript below. */
}
<div aria-hidden="true">
  <div class="ichat-terminal-heading" id={`${instanceId}-terminal-heading`}>
    <span id={`${instanceId}-terminal-title`}></span>
    <span id={`${instanceId}-terminal-cursor`} class="ichat-terminal-cursor">█</span>
  </div>

  <div class="ichat-phone-screen" id={`${instanceId}-phone-screen`}>
    <div id={`${instanceId}-imessage-chat`} class="ichat-imessage-chat"></div>
  </div>
</div>

{
  /* No wrapping <div> around these — a bare div gets exposed to screen
    readers as an unlabeled "group" that VoiceOver stops on before letting
    you continue into its contents. Marking each element sr-only directly
    keeps the heading/paragraphs as plain sequential content instead. */
}
<h2 class="sr-only">{terminalTitle}</h2>
<p class="sr-only">
  A conversation between {asker.name} and {responder.name}.
</p>
{
  conversation.map((turn) => (
    <>
      <p class="sr-only">
        <strong>{asker.name} asks:</strong> {turn.q}
      </p>
      <p class="sr-only">
        <strong>{responder.name} responds:</strong> {turn.a}
      </p>
    </>
  ))
}

<style is:global>
  /* Dynamically created by the client script below (document.createElement /
     innerHTML), so these rules can't be Astro-scoped — scoping only reaches
     elements written directly in this component's template. */

  .ichat-terminal-heading {
    font-family: Menlo, Monaco, Consolas, 'Courier New', monospace;
    font-size: 1.6rem;
    font-weight: 600;
    margin: 3rem 0 1rem;
    text-align: center;
  }

  .ichat-terminal-cursor {
    display: inline-block;
    margin-left: 3px;
    animation: ichatCursorBlink 0.7s infinite;
  }

  @keyframes ichatCursorBlink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  .ichat-phone-screen {
    max-width: 380px;
    margin: 1.2rem auto 3rem;
    background: #ffffff;
    border: 1px solid #d8d8dc;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }

  .ichat-phone-screen.ichat-phone-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ichat-imessage-chat {
    height: 640px;
    padding: 10px 10px 14px;
    background: #ffffff;
    /* The phone stays fixed; messages scroll inside it. */
    overflow-y: hidden;
    scroll-behavior: smooth;
  }

  .ichat-message-row {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    margin: 1px 0;
    opacity: 0;
    transform: translateY(8px);
    animation: ichatMessageIn 0.3s ease forwards;
  }

  .ichat-message-row.ichat-asker {
    justify-content: flex-end;
  }

  .ichat-message-row.ichat-responder {
    justify-content: flex-start;
  }

  .ichat-message-wrap {
    display: flex;
    flex-direction: column;
    max-width: 72%;
  }

  .ichat-asker .ichat-message-wrap {
    align-items: flex-end;
  }

  .ichat-responder .ichat-message-wrap {
    align-items: flex-start;
  }

  .ichat-sender {
    font-size: 10px;
    color: #8e8e93;
    margin: 0 6px 1px;
  }

  .ichat-bubble {
    padding: 8px 12px;
    border-radius: 18px;
    line-height: 1.35;
  }

  .ichat-asker .ichat-bubble {
    background: #0b84ff;
    color: white;
    border-bottom-right-radius: 5px;
  }

  .ichat-responder .ichat-bubble {
    background: #e9e9eb;
    color: #111;
    border-bottom-left-radius: 5px;
  }

  .ichat-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ichat-typing {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 15px 17px;
  }

  .ichat-typing span {
    width: 9px;
    height: 9px;
    background: #8e8e93;
    border-radius: 50%;
    animation: ichatTypingBounce 1.2s infinite;
  }

  .ichat-typing span:nth-child(2) {
    animation-delay: 0.18s;
  }

  .ichat-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes ichatTypingBounce {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-6px);
      opacity: 1;
    }
  }

  @keyframes ichatMessageIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 500px) {
    .ichat-phone-screen {
      max-width: 100%;
      border-radius: 20px;
    }

    .ichat-imessage-chat {
      height: 560px;
    }

    .ichat-message-wrap {
      max-width: 76%;
    }
  }
</style>

<script
  define:vars={{
    instanceId,
    terminalCommand,
    terminalTitle,
    askerName: asker.name,
    askerPhoto: asker.photo,
    responderName: responder.name,
    responderPhoto: responder.photo,
    conversation,
  }}
  is:inline
>
  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  const titleElement = document.getElementById(`${instanceId}-terminal-title`);
  const cursorElement = document.getElementById(`${instanceId}-terminal-cursor`);
  const phoneScreen = document.getElementById(`${instanceId}-phone-screen`);
  const chat = document.getElementById(`${instanceId}-imessage-chat`);

  async function typeText(text, speed = 90) {
    for (const char of text) {
      titleElement.textContent += char;
      await sleep(speed);
    }
  }

  async function eraseText(count, speed = 50) {
    for (let i = 0; i < count; i++) {
      titleElement.textContent = titleElement.textContent.slice(0, -1);
      await sleep(speed);
    }
  }

  async function animateTitle() {
    if (terminalCommand) {
      await typeText(terminalCommand, 90);
      await sleep(1400);
      await eraseText(terminalCommand.length, 50);
      await sleep(500);
    }
    await typeText(terminalTitle, 90);
    await sleep(700);
    // Hide cursor while title stays visible
    cursorElement.style.display = 'none';
  }

  function scrollChatToBottom() {
    chat.scrollTo({ top: chat.scrollHeight, behavior: 'smooth' });
  }

  function addMessage(sender, text) {
    const row = document.createElement('div');
    row.className = `ichat-message-row ichat-${sender}`;

    const photo = sender === 'asker' ? askerPhoto : responderPhoto;
    const name = sender === 'asker' ? askerName : responderName;

    const wrap = `
      <div class="ichat-message-wrap">
        <div class="ichat-sender">${name}</div>
        <div class="ichat-bubble text-base lg:text-xl">${text}</div>
      </div>
    `;
    const avatar = `<img class="ichat-avatar" src="${photo}" alt="${name}">`;

    row.innerHTML = sender === 'asker' ? `${wrap}${avatar}` : `${avatar}${wrap}`;

    chat.appendChild(row);
    requestAnimationFrame(() => scrollChatToBottom());
  }

  function addTyping(sender) {
    const row = document.createElement('div');
    row.className = `ichat-message-row ichat-${sender}`;
    row.id = `${instanceId}-${sender}-typing-indicator`;

    const photo = sender === 'asker' ? askerPhoto : responderPhoto;
    const name = sender === 'asker' ? askerName : responderName;

    const wrap = `
      <div class="ichat-message-wrap">
        <div class="ichat-sender">${name}</div>
        <div class="ichat-bubble ichat-typing text-base lg:text-xl">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    `;
    const avatar = `<img class="ichat-avatar" src="${photo}" alt="${name}">`;

    row.innerHTML = sender === 'asker' ? `${wrap}${avatar}` : `${avatar}${wrap}`;

    chat.appendChild(row);
    requestAnimationFrame(() => scrollChatToBottom());
  }

  function removeTyping(sender) {
    const typingIndicator = document.getElementById(`${instanceId}-${sender}-typing-indicator`);
    if (typingIndicator) {
      typingIndicator.remove();
    }
  }

  async function runChat() {
    for (const turn of conversation) {
      addTyping('asker');
      await sleep(1600);
      removeTyping('asker');
      addMessage('asker', turn.q);

      // Give the responder time to read
      await sleep(1500);

      addTyping('responder');
      await sleep(2200);
      removeTyping('responder');
      addMessage('responder', turn.a);

      // Pause before the next question
      await sleep(1800);
    }
  }

  async function resetExperience() {
    chat.innerHTML = '';
    chat.scrollTop = 0;
    phoneScreen.classList.remove('ichat-phone-visible');
    titleElement.textContent = '';
    cursorElement.style.display = 'inline-block';
    // Small pause before starting everything again
    await sleep(1200);
  }

  async function runExperience() {
    // eslint-disable-next-line no-constant-condition -- loops the whole animation forever
    while (true) {
      await animateTitle();
      await sleep(700);

      phoneScreen.classList.add('ichat-phone-visible');
      await sleep(900);

      await runChat();
      await sleep(4000);

      await resetExperience();
    }
  }

  runExperience();
</script>
