---
//import { splitEvents } from '~/content/utils.js'; // Import your event handling logic
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
//import { playlists } from '../utils/data';
import Headline from '~/components/ui/Headline.astro';
import FormattedDate from '~/components/events/FormattedDate.astro';
import EventAddress from '~/components/events/EventAddress.astro';
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
//import { Icon } from 'astro-icon/components';

const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' }));

const future_events = (
  await getCollection('event', ({ data }: CollectionEntry<'event'>) => {
    const eventEnd = data.endDate ? new Date(data.endDate) : new Date(data.dateTime);
    return eventEnd > now;
  })
).sort((b, a) => b.data.dateTime.valueOf() - a.data.dateTime.valueOf());

const all_past_events = (
  await getCollection('event', ({ data }: CollectionEntry<'event'>) => {
    const eventEnd = data.endDate ? new Date(data.endDate) : new Date(data.dateTime);
    return eventEnd < now && !data.partnerEvent;
  })
).sort((a, b) => b.data.dateTime.valueOf() - a.data.dateTime.valueOf());

// Show only 3 most recent past events on main page (excluding partner events)
const past_events = all_past_events.slice(0, 3);

const bwib_events = future_events.filter((e) => !e.data.partnerEvent);
const partner_future_events = future_events.filter((e) => e.data.partnerEvent);
const hasBwibEvents = bwib_events.length > 0;
---

{
  future_events.length === 0 ? (
    <>
      <Headline title="Upcoming Events" />
      <div class="grid grid-cols-1 gap-6 mb-8 md:mt-3 md:mb-12 text-center">
        <p>No upcoming events found.</p>
      </div>
      <Headline title="Past Events" />
      <div class="grid grid-cols-1 gap-6 mb-8 md:mt-3 md:mb-12 text-center">
        {past_events.length === 0 ? (
          <p>No past events found.</p>
        ) : (
          past_events.map((event) => (
            <Card padding="p-0" class="flex flex-col md:flex-row">
              <img
                src={event.data.image.src}
                alt={event.data.image.alt}
                class={`w-full md:h-48 md:w-48 h-auto object-cover ${event.data.imgpos}`}
                transition:name="playlist ${event.id} image"
              />
              <div class="p-4 flex-1">
                <h3
                  class="text-xl font-semibold mb-2 text-gray-900 dark:text-slate-100"
                  transition:name="playlist ${event.id} title"
                >
                  {event.data.title}
                </h3>
                <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                  <FormattedDate date={event.data.dateTime} endDate={event.data.endDate} />
                </div>
                <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                  <EventAddress artists={event.data.location || []} />
                </div>
                <Button variant="primary" href={`/events/${event.data.slug ?? event.id}`} text="MORE INFO" />
              </div>
            </Card>
          ))
        )}
      </div>
    </>
  ) : hasBwibEvents ? (
    <>
      <Headline title="Our Events" />
      <div class="grid grid-cols-1 gap-6 mb-8 md:mt-3 md:mb-12 text-center">
        {bwib_events.map((event) => (
          <Card
            padding="p-0"
            class="flex flex-col md:flex-row shadow-[0_0_15px_rgba(255,0,255,0.3),0_0_30px_rgba(0,255,255,0.2),0_0_45px_rgba(255,255,0,0.1)] hover:shadow-[0_0_20px_rgba(255,0,255,0.4),0_0_40px_rgba(0,255,255,0.3),0_0_60px_rgba(255,255,0,0.2)] transition-shadow duration-300"
          >
            <img
              src={event.data.image.src}
              alt={event.data.image.alt}
              class={`w-full md:h-48 md:w-48 h-auto object-cover ${event.data.imgpos}`}
              transition:name={`playlist ${event.id} image`}
            />
            <div class="p-4 flex-1">
              <h3
                class="text-xl font-semibold mb-2 text-gray-900 dark:text-slate-100"
                transition:name={`playlist ${event.id} title`}
              >
                {event.data.title}
              </h3>
              <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                <FormattedDate date={event.data.dateTime} endDate={event.data.endDate} />
              </div>
              <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                <EventAddress artists={event.data.location || []} />
              </div>
              <Button variant="primary" href={`/events/${event.data.slug ?? event.id}`} text="MORE INFO" />
            </div>
          </Card>
        ))}
      </div>
      {partner_future_events.length > 0 && (
        <>
          <Headline title="Partner Events" />
          <div class="grid grid-cols-1 gap-6 mb-8 md:mt-3 md:mb-12 text-center">
            {partner_future_events.map((event) => (
              <Card padding="p-0" class="flex flex-col md:flex-row">
                <img
                  src={event.data.image.src}
                  alt={event.data.image.alt}
                  class={`w-full md:h-48 md:w-48 h-auto object-cover ${event.data.imgpos} bg-white dark:bg-gray-800`}
                  transition:name={`playlist ${event.id} image`}
                />
                <div class="p-4 flex-1">
                  <h3
                    class="text-xl font-semibold mb-2 text-gray-900 dark:text-slate-100"
                    transition:name={`playlist ${event.id} title`}
                  >
                    {event.data.title}
                    <span class="ml-2 text-xs font-normal text-gray-500 dark:text-gray-400">(Partner Event)</span>
                  </h3>
                  <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                    <FormattedDate date={event.data.dateTime} endDate={event.data.endDate} />
                  </div>
                  <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                    <EventAddress artists={event.data.location || []} />
                  </div>
                  <Button variant="primary" href={`/events/${event.data.slug ?? event.id}`} text="MORE INFO" />
                </div>
              </Card>
            ))}
          </div>
        </>
      )}
    </>
  ) : (
    <>
      <Headline title="Upcoming Events" />
      <div class="grid grid-cols-1 gap-6 mb-8 md:mt-3 md:mb-12 text-center">
        {future_events.map((event) => (
          <Card padding="p-0" class="flex flex-col md:flex-row">
            <img
              src={event.data.image.src}
              alt={event.data.image.alt}
              class={`w-full md:h-48 md:w-48 h-auto object-cover ${event.data.imgpos} bg-white dark:bg-gray-800`}
              transition:name={`playlist ${event.id} image`}
            />
            <div class="p-4 flex-1">
              <h3
                class="text-xl font-semibold mb-2 text-gray-900 dark:text-slate-100"
                transition:name={`playlist ${event.id} title`}
              >
                {event.data.title}
                <span class="ml-2 text-xs font-normal text-gray-500 dark:text-gray-400">(Partner Event)</span>
              </h3>
              <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                <FormattedDate date={event.data.dateTime} endDate={event.data.endDate} />
              </div>
              <div class="text-sm mb-4 text-gray-700 dark:text-slate-300">
                <EventAddress artists={event.data.location || []} />
              </div>
              <Button variant="primary" href={`/events/${event.data.slug ?? event.id}`} text="MORE INFO" />
            </div>
          </Card>
        ))}
      </div>
    </>
  )
}

<div class="text-center mb-8">
  <Button variant="secondary" href="/events/archive" text="View Events Archive" />
</div>
