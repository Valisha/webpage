---
// Sponsors component - displays Gold and Silver tier sponsors
---

<section>
  <div class="max-w-6xl mx-auto px-4 text-center pt-12 pb-6">
    <h2 class="text-2xl font-semibold text-gray-800 dark:text-slate-100 mb-6">
      <span class="!text-gold font-bold" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">Gold</span> DNA Sponsors
    </h2>
    <div class="flex flex-wrap items-center justify-center gap-6">
      <a href="https://diamondage.com/" target="_blank" rel="noopener noreferrer">
        <div class="border-4 border-gold rounded-xl p-4 shadow-lg inline-block">
          <img
            src="/sponsors/diamondage_logo.png"
            alt="Gold DNA Sponsor: Diamond Age"
            class="mx-auto w-48 hover:scale-105 transition-transform duration-300 dark:brightness-0 dark:invert"
          />
        </div>
      </a>
      <a href="https://seqera.io/" target="_blank" rel="noopener noreferrer">
        <div class="border-4 border-gold rounded-xl p-4 shadow-lg inline-block">
          <img
            src="/sponsors/Logo_SeqeraL.png"
            alt="Gold DNA Sponsor: Seqera"
            class="mx-auto w-48 hover:scale-105 transition-transform duration-300 block dark:hidden"
          />
          <img
            src="/sponsors/Logo_SeqeraD.png"
            alt="Gold DNA Sponsor: Seqera"
            class="mx-auto w-48 hover:scale-105 transition-transform duration-300 hidden dark:block"
          />
        </div>
      </a>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 text-center pt-6 pb-12">
    <h2 class="text-2xl font-semibold text-gray-800 dark:text-slate-100 mb-6">
      <span class="!text-silver font-bold" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">Silver</span> RNA Sponsor
    </h2>
    <a href="https://www.benchling.com/" target="_blank" rel="noopener noreferrer">
      <div class="border-4 border-silver bg-slate-50 dark:bg-transparent rounded-xl p-4 shadow-lg inline-block">
        <img
          src="/sponsors/benchling_name_logo.png"
          alt="Silver RNA Sponsor: Benchling"
          class="mx-auto w-48 hover:scale-105 transition-transform duration-300 dark:brightness-0 dark:invert"
        />
      </div>
    </a>
  </div>
  <div class="max-w-6xl mx-auto px-4 text-center pt-6 pb-12">
    <h2 class="text-2xl font-semibold text-gray-800 dark:text-slate-100 mb-6">
      <span class="!text-bronze font-bold" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">Bronze</span> Protein Sponsors
    </h2>
    <a href="https://www.bioteam.net/" target="_blank" rel="noopener noreferrer">
      <div class="border-4 border-bronze bg-slate-50 dark:bg-transparent rounded-xl p-4 shadow-lg inline-block">
        <img
          src="/sponsors/bioteam_logo.png"
          alt="Bronze Protein Sponsor: Bioteam"
          class="mx-auto w-48 hover:scale-105 transition-transform duration-300 dark:brightness-0 dark:invert"
        />
      </div>
    </a>
    <a href="https://www.sproutinformatics.com/" target="_blank" rel="noopener noreferrer">
      <div class="border-4 border-bronze bg-slate-50 dark:bg-transparent rounded-xl p-4 shadow-lg inline-block">
        <img
          src="/sponsors/sprout_informatics_logo_full.png"
          alt="Bronze Protein Sponsor: Sprout Informatics"
          class="mx-auto w-48 hover:scale-105 transition-transform duration-300 dark:brightness-0 dark:invert"
        />
      </div>
    </a>
  </div>
</section>
