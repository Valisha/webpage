    <!-- Newsletter Sign-Up -->

    <div class="mb-8 mt-16">
      <div
        class="mx-auto max-w-screen-md dark:border dark:border-slate-600 dark:shadow-none p-8 rounded-md shadow-xl text-center my-auto"
      >
        <div class="text-center mb-0 md:mb-0 md:mx-auto">
          <div class="mb-4 lg:mb-8">
            <h3
              class="font-bold font-heading leading-tighter mb-4 tracking-tighter text-3xl sm:text-4xl md:text-5xl text-gray-900 dark:text-white"
            >
              Stay in the Loop
            </h3>
            <p class="text-muted text-xl dark:text-slate-400 my-4">
              Join the BWIB newsletter for fundraiser updates, event announcements, and community news.
            </p>
          </div>
          <div class="flex justify-center">
            <NewsletterSignup />
          </div>
        </div>
      </div>
    </div>

    <div class="text-center text-sm text-muted dark:text-slate-400 mt-4 mb-2 px-4">
      Boston Women in Bioinformatics is a 501(c)(3) nonprofit. Donations are tax-deductible as allowed by law.
    </div>
    <!-- Sponsorship tiers -->
    <section class="bg-white dark:bg-gray-900 border mt-12">
      <div class="py-12 px-4 mx-auto text-center lg:py-20 lg:px-6">
        <div class="sponsorship-intro text-center mb-10 mt-2">
          <h3 class="mb-4 text-3xl sm:text-4xl md:text-5xl tracking-tight font-extrabold text-gray-900 dark:text-white">
            Become a Sponsor
          </h3>
          <p class="text-lg text-muted dark:text-slate-300 mt-4 max-w-4xl mx-auto">
            Support Boston Women in Bioinformatics and get your organization in front of ~100 engaged researchers,
            industry professionals, and students at one of our signature annual events. Sponsors who commit early are
            featured in all save-the-date and announcement materials. Explore the tiers below and reach out to
            <a
              href="mailto:sponsorship@boston-wib.org?subject=Fall%20Fundraiser%20Sponsor"
              class="mr-2 ml-2 text-blue-600 dark:text-blue-400 hover:underline font-medium"
              >sponsorship@boston-wib.org</a
            >
            with the subject <span class="font-medium">"Fall Fundraiser Sponsor"</span> to get started.
          </p>
        </div>

        <div class="overflow-x-auto max-w-4xl mx-auto">
          <table
            class="w-full text-left border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden shadow-md text-sm sm:text-base"
          >
            <thead>
              <tr class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200">
                <th class="px-5 py-4 font-semibold w-1/2">Benefit</th>
                <th class="px-5 py-4 font-semibold text-center">
                  <span class="!text-gold font-bold" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">Gold</span> DNA Sponsor
                  <div class="text-red-600 dark:text-red-400 font-bold mt-1">$2,000</div>
                </th>
                <th class="px-5 py-4 font-semibold text-center">
                  <span class="!text-silver font-bold" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">Silver</span> RNA
                  Sponsor
                  <div class="text-red-600 dark:text-red-400 font-bold mt-1">$1,000</div>
                </th>
                <th class="px-5 py-4 font-semibold text-center">
                  <span class="!text-bronze font-bold" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3)">Bronze</span> Protein
                  Sponsor
                  <div class="text-red-600 dark:text-red-400 font-bold mt-1">$500</div>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700 text-gray-900 dark:text-white">
              <tr class="even:bg-gray-50 dark:even:bg-gray-800/50">
                <td class="px-5 py-4">
                  <span class="mr-2">🏆</span><strong>Prominent Logo Placement</strong>
                  <p class="text-sm text-muted dark:text-slate-400 mt-1">
                    Logo on all event marketing materials, including banners, flyers, and digital media.
                  </p>
                </td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
              </tr>
              <tr class="even:bg-gray-50 dark:even:bg-gray-800/50">
                <td class="px-5 py-4">
                  <span class="mr-2">🌐</span><strong>Website Recognition</strong>
                  <p class="text-sm text-muted dark:text-slate-400 mt-1">
