                <td class="px-5 py-4">
                  <span class="mr-2">🎙️</span><strong>Verbal Recognition</strong>
                  <p class="text-sm text-muted dark:text-slate-400 mt-1">
                    Priority mention during event opening and closing speeches.
                  </p>
                </td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
                <td class="px-5 py-4 text-center text-gray-300 dark:text-gray-600 text-xl">—</td>
              </tr>
              <tr class="even:bg-gray-50 dark:even:bg-gray-800/50">
                <td class="px-5 py-4">
                  <span class="mr-2">🎰</span><strong>Raffle Table Recognition</strong>
                  <p class="text-sm text-muted dark:text-slate-400 mt-1">
                    Company name and logo displayed at the raffle table throughout the event.
                  </p>
                </td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
                <td class="px-5 py-4 text-center text-xl">✓</td>
                <td class="px-5 py-4 text-center text-gray-300 dark:text-gray-600 text-xl">—</td>
