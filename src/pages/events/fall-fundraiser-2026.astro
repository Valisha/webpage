---

<Layout metadata={metadata}>
  <section>
    <div class="grid md:grid-cols-3 gap-8 items-center max-w-6xl mx-auto px-4 pt-8">
      <!-- Text content (takes 2/3 on desktop) -->
      <div class="md:col-span-2 text-center md:text-left">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tighter tracking-tighter font-heading dark:text-gray-200 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          Boston Women in Bioinformatics
        </h1>
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-8 font-heading dark:text-gray-200 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          2026 Fall Fundraiser
        </h2>
        <p
          class="text-xl sm:text-2xl font-semibold text-accent-warm dark:text-lime-400 mb-6 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          Women’s Health: Research, Investment, and What Comes Next
        </p>
        <div class="mb-8">
          <div class="text-lg text-muted dark:text-slate-300 mb-4">
            <p>Date: Thursday, October 1st, 2026</p>
            <p>Location: Eli Lilly, Seaport, Boston, MA</p>
            <p class="font-semibold">Ticket Cost: TBD</p>
          </div>
          <div class="group relative inline-block m-4">
            <div
              class="absolute -inset-2 rounded-full bg-gradient-to-r from-amber-400 via-orange-400 to-amber-400 opacity-75 blur-lg animate-pulse"
            >
            </div>
            <div class="relative">
              <AddToCalendarButton
                client:only="react"
                name="Boston Women in Bioinformatics 2026 Fall Fundraiser"
                location="Eli Lilly, Seaport, Boston, MA"
                startDate="2026-10-01"
                endDate="2026-10-01"
                startTime="17:00"
                endTime="21:00"
                styleLight="--btn-background: #d97706; --btn-text: #fff; --btn-shadow: 0 4px 12px rgba(217, 119, 6, 0.2); --btn-hover-background: #7c2d12; --btn-hover-text: #fff; --btn-hover-shadow: 0 6px 18px rgba(217, 119, 6, 0.35); --btn-border: none; --btn-border-radius: 9999px; --btn-font-weight: 600;"
                styleDark="--btn-background: #65742a; --btn-text: #fff; --btn-shadow: 0 4px 14px rgba(163, 230, 53, 0.2); --btn-hover-background: #a3e635; --btn-hover-text: #000; --btn-hover-shadow: 0 6px 20px rgba(163, 230, 53, 0.45); --btn-border: none; --btn-border-radius: 9999px; --btn-font-weight: 600;"
              />
            </div>
          </div>
        </div>
        <div
          class="text-lg text-muted mb-12 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          <p class="font-semibold mb-2">Agenda</p>
          <table class="w-full text-left">
            <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
              <tr>
                <td class="py-1.5 pr-4 align-top whitespace-nowrap font-medium">5:00–5:45 PM</td>
                <td class="py-1.5">Registration &amp; Networking</td>
              </tr>
              <tr>
                <td class="py-1.5 pr-4 align-top whitespace-nowrap font-medium">5:45–6:30 PM</td>
                <td class="py-1.5">
                  Opening Remarks
                  <ul class="mt-1 list-disc list-inside space-y-0.5 text-base text-muted dark:text-slate-400">
                    <li><i>Yevgenia Khodor, BWIB President</i></li>
                    <li><i>Gold Sponsor Spotlights</i></li>
                    <li><i>Eli Lilly</i></li>
                  </ul>
                </td>
              </tr>
              <tr>
                <td class="py-1.5 pr-4 align-top whitespace-nowrap font-medium">6:30–7:30 PM</td>
                <td class="py-1.5">Panel &amp; Q&amp;A</td>
              </tr>
              <tr>
                <td class="py-1.5 pr-4 align-top whitespace-nowrap font-medium">7:30–9:00 PM</td>
                <td class="py-1.5">Dinner, Networking, Raffle &amp; Silent Auction</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p
          class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          Join Boston Women in Bioinformatics on <b>Thursday, October 1, 2026, 5:00–9:00 PM</b> at <b
            >Eli Lilly in Seaport
          </b> for an evening dinner, a panel discussion, networking, and a raffle and silent auction with researchers, industry
          scientists, and data professionals who are shaping what comes next.
        </p>
        <p
          class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          Every dataset, pipeline, and model reflects the assumptions of its creators. <b
            >What scientific knowledge might we have today if women’s perspectives had been fully represented throughout
            history?</b
          > Hear from senior women leaders as they explore this question through the lens of federal policy, data infrastructure,
          reproductive and consumer health research, the $2.6B women’s health VC landscape, and the future of the field.
        </p>
        <p
          class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          <b
            >This is one of our rare ticketed events. Proceeds support BWiB's year-round programming, networking events,
            and community resources.</b
          > Student attendees will also be entered to win tickets to the <a
            href="/events/womens-healthx-december-2026"
            class="underline hover:text-primary dark:hover:text-blue-300">Women's HealthX Conference</a
          > this December.
        </p>
        <p
          class="text-base text-muted mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
        >
          Can't wait for the fundraiser to chat all things data gaps? Join our <a
            href="/events/invisible-women-book-club-2026"
            class="underline hover:text-primary dark:hover:text-blue-300">book club discussion of Invisible Women</a
          > on August 25th.
        </p>
      </div>
      <!-- Event logo (takes 1/3 on desktop) -->
      <div class="mx-auto max-w-xs w-full">
        <div class="block dark:hidden">
          <img
            src="/photos/2026/WIB_Logo_FallFundraiser_lightmode.png"
            alt="Women in Bioinformatics Fall Fundraiser Event logo"
          />
        </div>
        <div class="hidden dark:block">
          <img
            src="/photos/2026/WIB_Logo_FallFundraiser_darkmode.png"
            alt="Women in Bioinformatics Fall Fundraiser Event logo"
          />
        </div>
        <SponsorSection />
      </div>
    </div>

    <!-- Previous event description - uncomment and update when ready
    <p
      class="text-xl text-muted mx-2 sm:mx-5 md:mx-10 md:mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter text-center"
    >
      What can you really do with a bioinformatics degree? More than you might think.
    </p>
    <p
      class="text-xl text-muted mx-2 sm:mx-5 md:mx-10 md:mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter text-center"
    >
      Join Boston Women in Bioinformatics for an evening of honest, inspiring conversation with four speakers who took
      their bioinformatics training somewhere unexpected — from the paths they planned to the ones they never saw
      coming. Through personal stories and candid reflection, they'll explore the breadth of careers this field can lead
      to, what it takes to recognize and seize an opportunity, and what they wish they'd known earlier in their journey.
      Whether you're just starting out, considering a pivot, or simply curious about the road not taken, this is an
      evening worth showing up for. Stick around after the panel for drinks, light bites, and good company.
    </p>
    -->

    <div class="text-center">
      <!-- Register Button - uncomment and update when ready
      <a
        href="https://givebutter.com/BWIB10YRS"
        class="inline-flex items-center justify-center my-8 px-8 py-4 rounded-full text-white drop-shadow-[0_2px_2px_rgba(0,0,0,0.6)] text-xl font-extrabold tracking-wide bg-gradient-to-r from-pink-500 via-amber-500 to-pink-500 shadow-lg shadow-pink-400/40 transition-all ease-in-out transform hover:scale-110 hover:rotate-1 hover:shadow-yellow-500/60 ring-4 ring-pink-300 dark:from-fuchsia-600 dark:via-amber-500 dark:to-fuchsia-600 dark:shadow-fuchsia-500/50 dark:ring-amber-500 dark:drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)]"
      >
        🥳 Register Now! 🎉
      </a>-->

      <!-- Waitlist Sign-Up - uncomment and update when ready 
      <form id="waitlistForm">
        <label>
          <p class="text-red-500 text-xl my-4">
            If registration is full, drop your email below and we’ll let you know if a spot opens up.
          </p>
          <input
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            id="userEmail"
            placeholder="Enter your email"
            required
          />
        </label>
        <button
          type="submit"
          class="text-blue-700 hover:text-white border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2 dark:border-blue-500 dark:text-blue-500 dark:hover:text-white dark:hover:bg-blue-500 dark:focus:ring-blue-800"
          >Submit</button
        >
      </form>-->

      <script is:inline>
        const waitlistform = document.getElementById('waitlistForm');
        waitlistform.addEventListener('submit', function (e) {
          e.preventDefault();

          const email = document.getElementById('userEmail').value;
          const formUrl =
            'https://docs.google.com/forms/d/e/1FAIpQLSe2iOpSICCIfaqOlhUKXD1oU4STIGYpXirb9eHLpwZNUFqZKw/formResponse';
          const waitlistdata = new FormData();

          waitlistdata.append('entry.294683905', email);

          fetch(formUrl, {
            method: 'POST',
            mode: 'no-cors',
            body: waitlistdata,
          })
            .then(() => {
              alert('Thanks! Your email was submitted to the waitlist.');
              waitlistform.reset();
            })
            .catch((err) => {
              console.error('Submission error:', err);
              alert('Oops! Something went wrong.');
            });
        });
      </script>
    </div>
    <!-- Agenda Table - uncomment and update when ready
    <div class="min-h-screen flex flex-col items-center justify-center px-4 py-4">
      <h2 class="text-3xl font-bold mb-3">Agenda</h2>

      <div class="w-full max-w-xl overflow-x-auto">
        <table
          class="w-full text-left border border-gray-300 divide-y divide-gray-200 rounded-lg overflow-hidden shadow-md bg-white"
        >
          <thead class="bg-gray-100 font-semibold text-xl">
            <tr>
              <th class="px-4 py-3 text-right text-gray-700">Time</th>
              <th class="px-8 py-3 text-gray-700">Activity</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-lg text-gray-800">
            <tr>
              <td class="px-4 py-3 text-right">TBD</td>
              <td class="px-8 py-3">TBD</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
