<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script is:inline>
  // ── GATE LOGIC ────────────────────────────────────────────────────
  (function () {
    const STORAGE_KEY = 'wib_survey_unlocked';
    const gate = document.getElementById('survey-gate');
    const dashboard = document.getElementById('survey-dashboard');

    function unlock() {
      localStorage.setItem(STORAGE_KEY, '1');
      gate.classList.add('hidden');
      dashboard.classList.remove('hidden');
      // strip the param from the URL cleanly
      const url = new URL(window.location.href);
      url.searchParams.delete('unlocked');
      window.history.replaceState({}, '', url.toString());
    }

    const params = new URLSearchParams(window.location.search);
    if (params.get('unlocked') === 'true' || localStorage.getItem(STORAGE_KEY) === '1') {
      unlock();
    } else {
      gate.classList.remove('hidden');
    }

    const unlockBtn = document.getElementById('unlock-btn');
    if (unlockBtn) {
      unlockBtn.addEventListener('click', unlock);
    }
  })();

  // Dashboard uses cool tones (blue/purple/teal) as the default palette, with warm accent-warm
  // orange reserved for the one place it's semantically meaningful (job-seeking status). Light
  // mode uses pastel tints of the same tokens; dark mode uses the fully-saturated brand colors,
  // since pastels wash out against a dark background.
  const isDarkMode = document.documentElement.classList.contains('dark');
  // TEAL and INDIGO fill the "residual/other" chart slots that would otherwise default to a
  // flat gray — every slot gets an actual pastel hue instead of an achromatic one.
  const PALETTE = {
    light: {
      WARM: '#f3a973',
      BLUE: '#93c5fd',
      SECONDARY: '#7dd3fc',
      PURPLE: '#c4b5fd',
      PINK: '#f9a8d4',
      GOLD: '#e8d48a',
      TEAL: '#5eead4',
      INDIGO: '#a5b4fc',
      SUCCESS: '#86efac',
      WARNING: '#fdba74',
      ERROR: '#f5a3a3',
      INFO: '#a5d8ff',
    },
    dark: {
      WARM: '#e36d1d',
      BLUE: '#0161ef',
      SECONDARY: '#0154cf',
      PURPLE: '#6d28d9',
      PINK: '#db2777',
      GOLD: '#d4af37',
      TEAL: '#0d9488',
      INDIGO: '#4f46e5',
      SUCCESS: '#22c55e',
      WARNING: '#fb923c',
      ERROR: '#e74c3c',
      INFO: '#3b82f6',
    },
  };
  const C = isDarkMode ? PALETTE.dark : PALETTE.light;
  const { WARM, BLUE, SECONDARY, PURPLE, PINK, GOLD, TEAL, INDIGO, SUCCESS, WARNING, ERROR, INFO } = C;
  const MULTI = [BLUE, PURPLE, SUCCESS, SECONDARY, GOLD, ERROR, INFO, INDIGO, PINK, TEAL];

  // Legend/tick text and gridlines need an explicit theme-appropriate color — Chart.js's own
  // default is a mid-gray that doesn't have enough contrast in either theme. Axis ticks get
  // `tickColor` set directly (not just via Chart.defaults.color) so contrast is guaranteed
  // regardless of Chart.js's default-resolution behavior.
  let tickColor = isDarkMode ? '#e2e8f0' : '#334155';
  Chart.defaults.color = tickColor;
  const gridColor = isDarkMode ? '#334155' : '#f1f5f9';
  const allCharts = [];

  const DATA = {
    gender: { labels: ['Female', 'Male', 'Other / Prefer not to say'], values: [209, 48, 3] },
    location: {
      labels: ['MA', 'CA', 'NY', 'IN', 'TX', 'NJ', 'PA', 'CT', 'GA', 'MD', 'DE', 'Other'],
      values: [165, 20, 8, 7, 6, 5, 5, 4, 4, 3, 3, 25],
    },
    education: { labels: ['Bachelors', 'Masters', 'PhD', 'MD/PhD', 'Other'], values: [40, 102, 103, 10, 5] },
    concentration: {
      labels: [
        'Bioinformatics & Computational Biology',
        'Biology',
        'Computer Science',
        'Biophysics',
        'Biotechnology',
        'Biostatistics / Epidemiology',
        'Other',
      ],
      values: [148, 57, 4, 3, 5, 5, 38],
    },
    gradYear: { labels: ['Before 2010', '2010–2019', '2020–2025'], values: [20, 78, 159] },
    degreeOrigin: { labels: ['Within US', 'Outside US'], values: [207, 53] },
    employment: { labels: ['Employed', 'Job Seeking'], values: [179, 81] },
    jobType: { labels: ['Hybrid', 'In-person', 'Remote'], values: [81, 57, 41] },
    experience: { labels: ['0–1 years', '2–5 years', '5–8 years', '8+ years'], values: [68, 91, 38, 63] },
    compensation: {
      labels: ['< $80K', '$80K–$120K', '$121K–$150K', '$151K–$180K', '$181K–$200K', '> $200K'],
      values: [65, 39, 22, 4, 16, 22],
    },
    jobSearch: {
      labels: ['0–3 months', '3–6 months', '6–9 months', '9–12 months', 'Over 1 year'],
      values: [39, 21, 9, 5, 6],
    },
    companyType: {
      labels: ['Academia', 'Biotech', 'Big Pharma', 'Consulting/CRO', 'Private Non-profit', 'Other'],
      values: [68, 53, 18, 14, 13, 12],
    },
    companySize: { labels: ['0–100', '100–1,000', '1,000–10,000', 'Over 10,000'], values: [52, 31, 42, 47] },
    leadership: { labels: ['No', 'Yes'], values: [136, 43] },
    strategic: { labels: ['Yes', 'No'], values: [29, 14] },
    targetRole: { labels: ['Individual Contributor', 'Manager / Director'], values: [66, 11] },
    platforms: {
      labels: ['LinkedIn', 'Bluesky', 'X (Twitter)', 'Instagram', 'Email', 'Other'],
      values: [246, 32, 23, 7, 4, 8],
    },
    expertise: {
      labels: [
        'Computational Biology',
        'NGS Analysis',
        'Data Science',
        'Management',
        'Software Engineering',
        'Biostatistics',
        'AI / Machine Learning',
        'Structural Biology',
        'Statistical Genetics',
      ],
      values: [202, 189, 147, 47, 48, 48, 47, 35, 38],
    },
  };

  function pct(v, t) {
    return Math.round((v / t) * 100) + '%';
  }

  // Legend and axis text get more room on larger screens, so scale it up to match rather than
  // leaving it fixed at the same small size on every viewport.
  // Matches the text-sm/lg:text-base/xl:text-lg scale used for the rest of the dashboard's
  // small text, so canvas-rendered chart text is the same size as the surrounding HTML.
  function chartFontSize() {
    const w = window.innerWidth;
    if (w >= 1280) return 18;
    if (w >= 1024) return 16;
    return 14;
  }

  function donut(id, labels, values, colors) {
    const total = values.reduce(function (a, b) {
      return a + b;
    }, 0);
    const chart = new Chart(document.getElementById(id), {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{ data: values, backgroundColor: colors || MULTI, borderWidth: 2, borderColor: '#fff' }],
      },
      options: {
        cutout: '60%',
        plugins: {
          legend: {
            // 'right' squeezes long labels into a narrow side column and truncates them —
            // 'bottom' gets the chart's full width to wrap across lines instead.
            position: 'bottom',
            labels: { color: tickColor, font: { size: chartFontSize() }, padding: 10, boxWidth: 14 },
          },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ' ' + ctx.label + ': ' + ctx.raw + ' (' + pct(ctx.raw, total) + ')';
              },
            },
          },
        },
      },
    });
    allCharts.push(chart);
  }
  function hbar(id, labels, values, color) {
    const chart = new Chart(document.getElementById(id), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{ data: values, backgroundColor: color || BLUE, borderRadius: 6, borderSkipped: false }],
      },
      options: {
        indexAxis: 'y',
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ' ' + ctx.raw;
              },
            },
          },
        },
        scales: {
          x: {
            grid: { color: gridColor },
            ticks: { color: tickColor, font: { size: chartFontSize() - 1 } },
            beginAtZero: true,
          },
          y: { grid: { display: false }, ticks: { color: tickColor, font: { size: chartFontSize() } } },
        },
      },
    });
    allCharts.push(chart);
  }
  function vbar(id, labels, values, colors) {
    const isArr = Array.isArray(colors);
    const chart = new Chart(document.getElementById(id), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            data: values,
            backgroundColor: isArr
              ? colors
              : values.map(function () {
                  return colors || BLUE;
                }),
            borderRadius: 6,
            borderSkipped: false,
          },
        ],
      },
      options: {
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ' ' + ctx.raw;
              },
            },
          },
        },
        scales: {
          x: { grid: { display: false }, ticks: { color: tickColor, font: { size: chartFontSize() - 1 } } },
          y: {
            grid: { color: gridColor },
            ticks: { color: tickColor, font: { size: chartFontSize() - 1 } },
            beginAtZero: true,
          },
        },
      },
    });
    allCharts.push(chart);
  }
  function barList(containerId, labels, values, color) {
    const max = Math.max.apply(null, values);
    const ul = document.getElementById(containerId);
    labels.forEach(function (lbl, i) {
      const li = document.createElement('li');
      li.className = 's-bar-item text-sm lg:text-base xl:text-lg';
      li.innerHTML =
        '<div class="s-bl-label"><span>' +
        lbl +
        '</span><span>' +
        values[i] +
        '</span></div><div class="s-bar-track"><div class="s-bar-fill" style="width:' +
        (values[i] / max) * 100 +
        '%;background:' +
        (color || BLUE) +
        '"></div></div>';
      ul.appendChild(li);
    });
  }

  donut('genderChart', DATA.gender.labels, DATA.gender.values, [PINK, BLUE, PURPLE, TEAL]);
  barList('locationBars', DATA.location.labels, DATA.location.values, BLUE);
  vbar('educationChart', DATA.education.labels, DATA.education.values, MULTI);
  donut('concentrationChart', DATA.concentration.labels, DATA.concentration.values);
  vbar('gradYearChart', DATA.gradYear.labels, DATA.gradYear.values, ['#bfdbfe', '#93c5fd', '#60a5fa', BLUE]);
  donut('degreeOriginChart', DATA.degreeOrigin.labels, DATA.degreeOrigin.values, [BLUE, TEAL]);
  // Warm accent-warm orange is reserved for "Job Seeking" — the one place on this page where
  // drawing attention with the warm accent is semantically appropriate (see COLOR_PALETTE.md).
  donut('employmentChart', DATA.employment.labels, DATA.employment.values, [SUCCESS, WARM]);
  donut('jobTypeChart', DATA.jobType.labels, DATA.jobType.values, [PURPLE, BLUE, INFO]);
  vbar('experienceChart', DATA.experience.labels, DATA.experience.values, BLUE);
  vbar('compensationChart', DATA.compensation.labels, DATA.compensation.values, [
    '#bfdbfe',
    '#93c5fd',
    BLUE,
    WARNING,
    GOLD,
    '#1e3a5f',
  ]);
  vbar('jobSearchChart', DATA.jobSearch.labels, DATA.jobSearch.values, BLUE);
  donut('companyTypeChart', DATA.companyType.labels, DATA.companyType.values);
  vbar('companySizeChart', DATA.companySize.labels, DATA.companySize.values, ['#bfdbfe', '#60a5fa', BLUE, '#1e3a5f']);
  donut('leadershipChart', DATA.leadership.labels, DATA.leadership.values, [TEAL, GOLD]);
  donut('strategicChart', DATA.strategic.labels, DATA.strategic.values, [SUCCESS, TEAL]);
  donut('targetRoleChart', DATA.targetRole.labels, DATA.targetRole.values, [SECONDARY, BLUE, PURPLE]);
  barList('platformBars', DATA.platforms.labels, DATA.platforms.values, BLUE);
  hbar('platformChart', DATA.platforms.labels, DATA.platforms.values, BLUE);
  hbar('expertiseChart', DATA.expertise.labels, DATA.expertise.values, BLUE);

  // Chart dataset colors are baked in at creation, but legend/tick text color can be updated
  // live so it stays legible if the user toggles theme without reloading the page. Legend and
  // axis tick colors are set explicitly per-chart (not just via Chart.defaults.color), so each
  // has to be reassigned individually here too.
  new MutationObserver(function () {
    const nowDark = document.documentElement.classList.contains('dark');
    tickColor = nowDark ? '#e2e8f0' : '#334155';
    Chart.defaults.color = tickColor;
    allCharts.forEach(function (chart) {
      const legendLabels = chart.options.plugins && chart.options.plugins.legend && chart.options.plugins.legend.labels;
      if (legendLabels) legendLabels.color = tickColor;
      const scales = chart.options.scales;
      if (scales) {
        if (scales.x) scales.x.ticks.color = tickColor;
        if (scales.y) scales.y.ticks.color = tickColor;
      }
      chart.update();
    });
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // Re-scale legend and axis text if the viewport crosses a breakpoint (resize or rotation),
  // not just at initial load.
  let resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      const size = chartFontSize();
      allCharts.forEach(function (chart) {
        const legendLabels =
          chart.options.plugins && chart.options.plugins.legend && chart.options.plugins.legend.labels;
        if (legendLabels) {
          legendLabels.font.size = size;
        }
        const scales = chart.options.scales;
        if (scales) {
          // hbar puts category labels on the y-axis (full chartFontSize, matching donut legends);
          // its numeric x-axis, and both axes on vbar, use one size smaller.
          const isHbar = chart.options.indexAxis === 'y';
          if (scales.x) scales.x.ticks.font.size = size - 1;
          if (scales.y) scales.y.ticks.font.size = isHbar ? size : size - 1;
        }
        chart.update();
      });
    }, 150);
  });

  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  function showSurveySection(id, btn) {
    document.querySelectorAll('.survey-section').forEach(function (s) {
      s.classList.add('hidden');
    });
    document.querySelectorAll('.survey-tab-btn').forEach(function (b) {
      b.classList.remove('active', 'text-accent-warm', 'border-accent-warm');
      b.classList.add('text-muted', 'border-transparent');
    });
    document.getElementById(id).classList.remove('hidden');
    btn.classList.add('active', 'text-accent-warm', 'border-accent-warm');
    btn.classList.remove('text-muted', 'border-transparent');
  }
  // init first tab active state
  (function () {
    const first = document.querySelector('.survey-tab-btn');
    if (first) {
      first.classList.add('text-accent-warm', 'border-accent-warm');
      first.classList.remove('text-muted', 'border-transparent');
    }
  })();
</script>

